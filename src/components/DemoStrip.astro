---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { demo } = t(lang);
---

<aside class="demo-strip" aria-label={lang === 'it' ? 'Avviso: sito dimostrativo' : 'Notice: demo website'}>
  <p class="container demo-strip__inner">
    <span class="demo-strip__badge label">{demo.badge}</span>
    <span class="demo-strip__text">{demo.text}</span>
  </p>
</aside>

<style>
  .demo-strip {
    background: var(--night);
    color: var(--night-fg);
  }
  .demo-strip__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2) var(--space-4);
    padding-block: var(--space-2);
    max-width: none;
    text-align: center;
  }
  .demo-strip__badge {
    background: var(--night-accent);
    /* Testo scuro fisso su turchese chiaro: 8:1 (mai bianco). */
    color: var(--night);
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    font-weight: 700;
  }
  .demo-strip__text {
    font-size: var(--step--1);
  }
</style>
