---
/**
 * Biglietto evento: tagliando con la data + corpo. Senza `event` mostra l'impaginazione con segnaposto
 * (il calendario reale manca: vedi src/data/events.ts).
 */
import type { EventItem } from '../data/events';

interface Props {
  event?: EventItem;
}
const { event } = Astro.props;

const when = event ? new Date(`${event.date}T00:00:00Z`) : null;
const fmt = (opts: Intl.DateTimeFormatOptions) =>
  when ? new Intl.DateTimeFormat('it-IT', { timeZone: 'UTC', ...opts }).format(when) : '';
---

<script>
  // Un solo import/chiamata anche con più biglietti in pagina: Astro deduplica gli <script> identici.
  import { wireIcsLinks } from '../scripts/calendar';
  wireIcsLinks();
</script>

<article class:list={['ticket', { 'ticket--empty': !event }]}>
  <div class="ticket__stub" aria-hidden={event ? undefined : 'true'}>
    {
      event ? (
        <>
          <span class="label">{fmt({ weekday: 'short' })}</span>
          <span class="ticket__day">{fmt({ day: 'numeric' })}</span>
          <span class="label">{fmt({ month: 'short' })}</span>
        </>
      ) : (
        <>
          <span class="label">gg</span>
          <span class="ticket__day">––</span>
          <span class="label">mese</span>
        </>
      )
    }
  </div>
  <div class="ticket__body">
    {
      event ? (
        <>
          <h3>{event.title}</h3>
          {event.description && <p>{event.description}</p>}
          <ul class="ticket__meta label" role="list">
            {event.time && <li>{event.time}</li>}
            {event.price && <li>{event.price}</li>}
          </ul>
          <a
            class="ticket__ics"
            href="#"
            download
            data-ics
            data-ics-title={event.title}
            data-ics-date={event.date}
            data-ics-time={event.time}
            data-ics-desc={event.description}
            data-ics-loc="Fairuz — Via Luigi Vigotti 5, 43126 Parma"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <rect x="1.5" y="2.5" width="13" height="12" rx="1.5"></rect>
              <path d="M1.5 6h13M4.5 1v3M11.5 1v3"></path>
            </svg>
            Aggiungi al calendario
          </a>
        </>
      ) : (
        <>
          <div class="ticket__lines" aria-hidden="true">
            <span class="bar bar--title"></span>
            <span class="bar"></span>
            <span class="bar bar--short"></span>
          </div>
          <slot />
        </>
      )
    }
  </div>
</article>

<style>
  .ticket {
    display: grid;
    background: var(--surface);
    border: var(--rule-w) solid var(--rule-strong);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .ticket--empty {
    border-style: dashed;
  }
  .ticket__stub {
    display: flex;
    flex-direction: row;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    /* Testo scuro fisso su turchese pieno (regola 5): identico in entrambi i temi. */
    background: var(--turquoise);
    color: var(--night);
    border-bottom: 2px dashed var(--night);
  }
  .ticket__day {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: var(--step-4);
    line-height: 1;
  }
  .ticket__body {
    display: grid;
    gap: var(--space-3);
    align-content: center;
    padding: var(--space-5);
  }
  .ticket__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: 0;
    padding: 0;
    color: var(--link);
  }
  .ticket__lines {
    display: grid;
    gap: var(--space-2);
  }
  .bar {
    display: block;
    height: 0.75rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .bar--title {
    width: 50%;
    height: 1.25rem;
  }
  .bar--short {
    width: 65%;
  }

  /* Azione utile del biglietto: scarica un .ics reale (RFC 5545), non solo decorazione. */
  .ticket__ics {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    justify-self: start;
    min-height: var(--touch-min);
    padding-inline: var(--space-3);
    margin-top: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--link);
    border: var(--rule-w) solid var(--rule);
    border-radius: var(--radius-pill);
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }
  .ticket__ics svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ticket__ics:hover {
    background: var(--turquoise);
    color: var(--night);
    border-color: var(--turquoise);
  }

  @media (min-width: 40rem) {
    .ticket {
      grid-template-columns: 9rem 1fr;
    }
    .ticket__stub {
      flex-direction: column;
      align-items: center;
      gap: var(--space-1);
      border-bottom: 0;
      border-right: 2px dashed var(--night);
    }
  }
</style>
