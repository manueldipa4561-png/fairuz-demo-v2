---
/**
 * Cornice per una foto reale di Fairuz. Mostra la foto se il file esiste in `public/photos`
 * (vedi src/lib/photo.ts); altrimenti non renderizza nulla: chi la usa decide l'impaginato senza foto.
 * Le proporzioni vengono da `--photo-ratio` (impostata da chi usa il componente).
 */
import { findPhoto } from '../lib/photo';

interface Props {
  /** Nome del file in /public/photos senza estensione (es. "barbecue"). */
  name?: string;
  /** Testo alternativo descrittivo per chi non vede la foto. */
  alt?: string;
}
const { name, alt = '' } = Astro.props;
const src = findPhoto(name);
---

{
  src && (
    <figure class="photo-frame">
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    </figure>
  )
}

<style>
  .photo-frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--photo-ratio, 4 / 3);
    border: var(--rule-w) solid currentColor;
    overflow: hidden;
  }
  /* Filetto interno chiaro: eco delle carte stampate, resta leggibile su qualsiasi foto. */
  .photo-frame::before {
    content: '';
    position: absolute;
    inset: var(--space-2);
    border: var(--rule-w) solid color-mix(in srgb, #fff 70%, transparent);
    pointer-events: none;
    z-index: 1;
  }
  .photo-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
