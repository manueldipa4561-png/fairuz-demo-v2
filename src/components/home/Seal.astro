---
/**
 * Sigillo "FAIRUZ · PARMA · CUCINA LIBANESE" (reinterpretazione del timbro del riferimento Da Maria).
 * Decorativo. Riempimento turchese + testo scuro fisso (--night): leggibile in entrambi i temi (regola 5).
 *
 * Base statica + anello col testo dentro un <div> che ruota (transform su un elemento HTML, non su
 * un <g>/<svg> con <text>): ruotare direttamente l'SVG col testo faceva rifare il layout a ogni frame
 * (misurato: 277 layout in 4 s, ~2 s di CPU su mobile 4x).
 */
const track = `seal-track-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="seal" aria-hidden="true" data-seal>
  <svg class="seal__base" viewBox="0 0 200 200" focusable="false">
    <circle class="seal__disc" cx="100" cy="100" r="98"></circle>
    <circle class="seal__line" cx="100" cy="100" r="90"></circle>
    <circle class="seal__line" cx="100" cy="100" r="54"></circle>
    <path class="seal__mark" d="M100 72 L120 100 L100 128 L80 100 Z"></path>
    <path class="seal__line" d="M100 84 L111 100 L100 116 L89 100 Z"></path>
  </svg>
  <div class="seal__spin">
    <svg class="seal__ring" viewBox="0 0 200 200" focusable="false">
      <defs>
        <path id={track} d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0"></path>
      </defs>
      <text class="seal__text">
        <textPath href={`#${track}`} textLength="448" lengthAdjust="spacing">
          FAIRUZ · PARMA · CUCINA LIBANESE ·
        </textPath>
      </text>
    </svg>
  </div>
</div>

<style>
  .seal {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .seal svg,
  .seal__spin {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .seal__disc {
    fill: var(--turquoise);
  }
  .seal__line {
    fill: none;
    stroke: var(--night);
    stroke-width: 1.5;
  }
  .seal__mark {
    fill: var(--night);
  }
  .seal__text {
    fill: var(--night);
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
  }
  .seal__spin {
    will-change: transform;
    animation: seal-spin 40s linear infinite;
  }
  @keyframes seal-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
