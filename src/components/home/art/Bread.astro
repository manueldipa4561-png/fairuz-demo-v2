---
/** Pane piatto spezzato a metà: le due metà (`data-bread-left/right`) si separano durante lo scroll. */
const tear = 'L208 290 L194 262 L210 236 L192 206 L206 178 L194 150 L208 122 L196 100 Z';
const crumbs = [
  [200, 340, 3], [188, 352, 2], [214, 356, 2.5], [196, 368, 1.8], [224, 344, 1.6],
];
---

<svg class="art" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <g class="art__ink">
    <g data-bread-left>
      <path class="art__crust" data-draw pathLength="1" d={`M200 80 A120 120 0 0 0 200 320 ${tear}`}></path>
      <path data-draw pathLength="1" d="M186 110 A94 94 0 0 0 186 290"></path>
      <circle cx="130" cy="170" r="3"></circle>
      <circle cx="150" cy="240" r="3"></circle>
      <circle cx="118" cy="220" r="2"></circle>
    </g>
    <g data-bread-right>
      <path class="art__crust" data-draw pathLength="1" d={`M200 80 A120 120 0 0 1 200 320 ${tear}`}></path>
      <path data-draw pathLength="1" d="M214 110 A94 94 0 0 1 214 290"></path>
      <circle cx="268" cy="160" r="3"></circle>
      <circle cx="252" cy="236" r="3"></circle>
      <circle cx="286" cy="214" r="2"></circle>
    </g>
  </g>
  <g class="art__crumbs">
    {crumbs.map(([cx, cy, r]) => <circle data-crumb cx={cx} cy={cy} r={r} />)}
  </g>
</svg>

<style>
  .art__ink {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art__ink circle,
  .art__crumbs {
    fill: currentColor;
    stroke: none;
  }
  .art__crust {
    fill: color-mix(in srgb, var(--blush) 45%, transparent);
  }
</style>
