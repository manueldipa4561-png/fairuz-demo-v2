---
/** Brace: fiamme sulla griglia, carboni, scintille. Tratti `data-draw` (pathLength=1) per il draw-on. */
const sparks = [
  [168, 232, 2.5], [184, 214, 2], [200, 240, 3], [214, 222, 2], [228, 236, 2.5],
  [150, 250, 2], [246, 250, 2], [192, 196, 1.8], [208, 202, 2.2], [176, 246, 1.8],
  [222, 250, 2], [236, 214, 1.6], [162, 214, 1.6], [200, 210, 2.4], [240, 232, 1.8],
];
---

<svg class="art" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <g class="art__ink">
    <path data-flame data-draw pathLength="1" d="M200 256 C160 222 172 178 200 128 C212 170 242 186 230 222 C242 212 248 198 246 182 C266 212 262 244 232 258"></path>
    <path data-flame data-draw pathLength="1" d="M150 262 C126 240 134 212 152 192 C156 218 174 228 170 252"></path>
    <path data-flame data-draw pathLength="1" d="M254 262 C276 242 272 216 258 200 C252 224 236 234 240 256"></path>
    <path data-draw pathLength="1" d="M70 272 H330 M80 292 H320"></path>
    <path data-draw pathLength="1" d="M100 264 V300 M140 264 V300 M180 264 V300 M220 264 V300 M260 264 V300 M300 264 V300"></path>
    <path data-draw pathLength="1" d="M90 332 C96 312 126 310 132 330 C140 310 172 310 176 332 C184 310 216 310 222 332 C230 310 262 310 268 332 C276 312 306 312 310 332"></path>
    <path data-draw pathLength="1" d="M60 346 H340"></path>
  </g>
  <g class="art__sparks">
    {sparks.map(([cx, cy, r]) => <circle data-spark cx={cx} cy={cy} r={r} />)}
  </g>
</svg>

<style>
  .art__ink {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art__sparks {
    fill: var(--night-warn);
  }
</style>
