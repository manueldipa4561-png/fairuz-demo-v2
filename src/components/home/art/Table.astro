---
/** Tavola vista dall'alto: i piattini (`data-plate`) arrivano uno alla volta attorno al piatto centrale. */
const plates = [0, 60, 120, 180, 240, 300].map((deg, i) => {
  const a = (deg * Math.PI) / 180;
  return { x: 200 + 86 * Math.cos(a), y: 200 + 86 * Math.sin(a), fill: i % 2 ? 'blush' : 'turq' };
});
---

<svg class="art" viewBox="0 0 400 400" aria-hidden="true" focusable="false">
  <g class="art__ink">
    <circle data-draw pathLength="1" cx="200" cy="200" r="150"></circle>
    <circle class="art__faint" data-draw pathLength="1" cx="200" cy="200" r="140"></circle>
    <g data-plate>
      <circle cx="200" cy="200" r="36"></circle>
      <path d="M176 192 H224 M172 204 H228 M180 216 H220"></path>
    </g>
    {
      plates.map((p) => (
        <g data-plate>
          <circle class={`art__fill--${p.fill}`} cx={p.x} cy={p.y} r="26" />
          <circle cx={p.x} cy={p.y} r="17" />
          <path d={`M${p.x - 7} ${p.y} a7 7 0 1 1 7 7 a4 4 0 0 1 -4 -4`} />
        </g>
      ))
    }
  </g>
</svg>

<style>
  .art__ink {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .art__faint {
    stroke-width: 1;
  }
  .art__fill--turq {
    fill: color-mix(in srgb, var(--turquoise) 55%, transparent);
  }
  .art__fill--blush {
    fill: color-mix(in srgb, var(--blush) 70%, transparent);
  }
</style>
