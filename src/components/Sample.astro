---
/**
 * Marcatore "Esempio": contenuto dimostrativo realistico ma NON confermato dal cliente.
 * Diverso dal <Todo> (rosso, contenuto mancante): qui il contenuto c'è ma è di esempio.
 * Turchese pieno + testo scuro fisso (regola 5), leggibile in chiaro e scuro.
 */
interface Props {
  /** Testo del badge (default "Esempio"). */
  label?: string;
}
const { label = 'Esempio' } = Astro.props;
---

<span class="sample label">{label}<slot /></span>

<style>
  .sample {
    display: inline-block;
    padding: 0 var(--space-2);
    background: var(--turquoise);
    color: var(--night);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }
</style>
