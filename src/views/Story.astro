---
import CtaBand from '../components/CtaBand.astro';
import PageHero from '../components/PageHero.astro';
import PhotoFrame from '../components/PhotoFrame.astro';
import Sample from '../components/Sample.astro';
import RhombusDivider from '../components/home/RhombusDivider.astro';
import { findPhoto } from '../lib/photo';
import { pathFor, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Solo italiano (regola 8): l'inglese si riattiva riscrivendo questo blocco per lingua.
// Nessun fatto sul locale: la storia reale, le persone e l'origine del nome (regola 3) arrivano dal cliente.
const c = {
  eyebrow: 'Storia',
  title: 'La nostra storia',
  intro: 'Il Libano a Parma, raccontato a tavola.',
  sampleNote: 'Testi dimostrativi: la storia reale la racconta Fairuz.',
  chapters: [
    {
      id: 'origini',
      kicker: 'Le origini',
      body: 'Fairuz nasce dal desiderio di portare a Parma la tavola libanese: quella in cui il cibo è prima di tutto un gesto di ospitalità. Ogni piatto racconta un pezzo di Mediterraneo, tra spezie, brace e pane condiviso.',
      file: 'locale',
      alt: 'Il locale di Fairuz',
    },
    {
      id: 'cucina',
      kicker: 'La cucina',
      body: 'Tutto parte dalla brace e dalle mani: le mezze preparate ogni giorno, le grigliate marinate a lungo, i dolci che chiudono il pasto. Sapori tradizionali, senza scorciatoie, come si fa a casa.',
      file: 'tavola-iftar',
      alt: 'Hummus e mezze su una tavola apparecchiata',
    },
    {
      id: 'persone',
      kicker: 'Le persone',
      body: 'Dietro ogni serata c’è chi accoglie in sala e chi lavora alla griglia. È da qui che nasce il modo di stare a tavola di Fairuz: senza fretta, come tra ospiti.',
      file: 'chef-strada',
      alt: 'Lo chef di Fairuz che prepara i piatti',
    },
  ],
  nameTitle: 'Il nome',
  nameBody: '«Fairuz» è un nome che nel mondo arabo evoca musica, luce e ospitalità. Per noi è soprattutto un invito: sedersi, condividere, sentirsi a casa.',
  menuCta: 'Scopri il menu',
  bandTitle: 'La storia continua a tavola.',
};
const chapters = c.chapters.map((ch) => ({ ...ch, hasPhoto: Boolean(findPhoto(ch.file)) }));
---

<PageHero eyebrow={c.eyebrow} title={c.title} intro={c.intro}>
  <p class="story-note"><Sample /> {c.sampleNote}</p>
</PageHero>

{
  chapters.map((ch, i) => (
    <section class:list={['story', { 'story--flip': i % 2 === 1 }]} id={ch.id} aria-labelledby={`${ch.id}-title`}>
      <div class:list={['container story__grid', { 'story__grid--single': !ch.hasPhoto }]}>
        <div class="story__text">
          <p class="label label--link story__index">
            <span>{String(i + 1).padStart(2, '0')}</span>
            <span>{ch.kicker}</span>
          </p>
          <h2 id={`${ch.id}-title`}>{ch.kicker}</h2>
          <p class="story__body story__body--dropcap">{ch.body}</p>
        </div>
        {ch.hasPhoto && (
          <div class="story__photo">
            <PhotoFrame name={ch.file} alt={ch.alt} />
          </div>
        )}
      </div>
    </section>
  ))
}

<RhombusDivider />

<section class="section" aria-labelledby="name">
  <div class="container stack">
    <h2 id="name">{c.nameTitle} <Sample /></h2>
    <p>{c.nameBody}</p>
    <p class="actions">
      <a class="btn btn--ghost" href={pathFor('menu', lang)}>{c.menuCta}</a>
    </p>
  </div>
</section>

<CtaBand lang={lang} title={c.bandTitle} />

<style>
  .story-note {
    margin-top: var(--space-5);
  }
  .story {
    padding-block: var(--space-8);
    border-bottom: var(--rule-w) solid var(--rule);
  }
  .story__grid {
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }
  .story__text {
    display: grid;
    gap: var(--space-4);
    align-content: center;
  }
  .story__index {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }
  .story__index span:first-child {
    padding: 0.1em 0.6em;
    border: var(--rule-w) solid currentColor;
    border-radius: var(--radius-pill);
  }
  .story__grid--single .story__text {
    max-width: 44rem;
  }
  .story__photo {
    --photo-ratio: 4 / 3;
    width: 100%;
    max-width: 26rem;
    justify-self: center;
  }

  @media (min-width: 60rem) {
    .story__grid:not(.story__grid--single) {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
    }
    .story--flip .story__text {
      order: 2;
    }
    .story__photo {
      --photo-ratio: 4 / 5;
      justify-self: start;
    }
    .story--flip .story__photo {
      justify-self: end;
    }
  }
</style>
