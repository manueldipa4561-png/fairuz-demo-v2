---
import PageHero from '../components/PageHero.astro';
import Todo from '../components/Todo.astro';
import { type Lang } from '../i18n';
import { restaurant } from '../data/restaurant';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = restaurant.address;

const c = {
  it: {
    eyebrow: 'Visita & Prenota',
    title: 'Visita & Prenota',
    intro: 'Vieni a trovarci in Via Luigi Vigotti, a Parma.',
    where: 'Dove siamo',
    map: 'Apri la mappa',
    contacts: 'Contatti',
    whatsapp: 'Scrivici su WhatsApp',
    hours: 'Orari',
    hoursTodo: 'orari reali (giorni, pranzo e cena, chiusura settimanale) da confermare',
    services: 'Servizi',
    // Servizi dichiarati sul sito attuale del ristorante (fairuz.eatbu.com).
    list: ['Aria condizionata', 'Parcheggio non custodito', 'Accessibile', 'Wi-Fi gratuito', 'Animali domestici ammessi', 'Take away'],
    bookTitle: 'Prenota un tavolo',
    bookTodo: 'Fase 4 — modulo Standard Booking (data, ora, persone), dimostrativo e senza backend, con WhatsApp come via secondaria',
    newTab: '(si apre in una nuova scheda)',
  },
  en: {
    eyebrow: 'Visit & Book',
    title: 'Visit & Book',
    intro: 'Come and see us on Via Luigi Vigotti, in Parma.',
    where: 'Find us',
    map: 'Open the map',
    contacts: 'Contact',
    whatsapp: 'Message us on WhatsApp',
    hours: 'Opening hours',
    hoursTodo: 'real opening hours (days, lunch and dinner, weekly closing) to confirm',
    services: 'Services',
    list: ['Air conditioning', 'Unattended parking', 'Accessible', 'Free Wi-Fi', 'Pets welcome', 'Take away'],
    bookTitle: 'Book a table',
    bookTodo: 'Phase 4 — Standard Booking form (date, time, party size), demonstration only with no backend, with WhatsApp as a secondary route',
    newTab: '(opens in a new tab)',
  },
}[lang];
---

<PageHero eyebrow={c.eyebrow} title={c.title} intro={c.intro} />

<section class="section" aria-labelledby="prenota">
  <div class="container">
    <div class="section-head">
      <h2 id="prenota">{c.bookTitle}</h2>
    </div>
    <p><Todo>{c.bookTodo}</Todo></p>
  </div>
</section>

<section class="section" style="padding-top: 0">
  <div class="container facts">
    <div>
      <h3>{c.where}</h3>
      <address>
        {a.street}<br />
        {a.postalCode} {a.city}<br />
        <a href={restaurant.mapsHref} target="_blank" rel="noopener noreferrer">
          {c.map}<span class="sr-only"> {c.newTab}</span>
        </a>
      </address>
    </div>
    <div>
      <h3>{c.contacts}</h3>
      <ul class="tick-list">
        <li><a href={restaurant.phoneHref}>{restaurant.phone}</a></li>
        <li><a href={`mailto:${restaurant.email}`}>{restaurant.email}</a></li>
        <li>
          <a href={restaurant.whatsappHref} target="_blank" rel="noopener noreferrer">
            {c.whatsapp}<span class="sr-only"> {c.newTab}</span>
          </a>
        </li>
      </ul>
    </div>
    <div>
      <h3>{c.hours}</h3>
      <p><Todo>{c.hoursTodo}</Todo></p>
    </div>
    <div>
      <h3>{c.services}</h3>
      <ul class="tick-list">
        {c.list.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
